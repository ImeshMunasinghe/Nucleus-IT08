void drawShape() {
if (!shapeVisible) return;
u8g2.setDrawColor(1); // White shape
switch (currentShape) {
case CIRCLE: drawCircle(shapeX, shapeY); break;
case HEART: drawHeart(shapeX, shapeY); break;
case TRIANGLE: drawTriangle(shapeX, shapeY); break;
}
}
// ===== OLED Update (Mode-specific behavior) =====
void updateOLED() {
u8g2.clearBuffer();
if (currentMode == ENTERTAINMENT_MODE) {
// Entertainment Mode OLED
u8g2.setDrawColor(0);
u8g2.drawBox(0, 0, screenWidth, screenHeight); // Black background
if (startupAnimation) {
// Animate "Let's Dance" from right to left
u8g2.setFont(u8g2_font_fub20_tf);
u8g2.setDrawColor(1); // White text
const char* text = "Let's Dance";
u8g2.drawStr((int)textX, centerY + 10, text);
textX -= textSpeed;
if (textX < -100) {
startupAnimation = false; // End animation
shapeX = centerX; // Reset shape position
shapeY = centerY;
}
u8g2.sendBuffer();
return;
}
// Switch shapes every 5 seconds
if (millis() - lastShapeSwitch >= SHAPE_SWITCH_INTERVAL) {
currentShape = (ShapeType)((currentShape + 1) % 3); // Cycle: CIRCLE -> HEART -> TRIANGLE
lastShapeSwitch = millis();
}
// Update shape position
float targetX = shapeX;
float targetY = shapeY;
bool isMoving = false;
if (currentMove == STOPPED_E) {
if (millis() - lastIdleMove >= 1000) {
lastIdleMove = millis();
idleDirection = random(4); // 0: left, 1: right, 2: up, 3: down
}
switch (idleDirection) {
case 0: targetX -= 2.0; isMoving = true; break; // Left
case 1: targetX += 2.0; isMoving = true; break; // Right
case 2: targetY -= 2.0; isMoving = true; break; // Up
case 3: targetY += 2.0; isMoving = true; break; // Down
}
} else {
switch (currentMove) {
case FORWARD_E: targetY -= 2.0; isMoving = true; break; // Up
case BACKWARD_E: targetY += 2.0; isMoving = true; break; // Down
case TURN_LEFT_E: targetX -= 2.0; isMoving = true; break; // Left
case TURN_RIGHT_E: targetX += 2.0; isMoving = true; break; // Right
case SPIN_E: targetX += 2.0; isMoving = true; break; // Right
default: break;
}
}
// Smooth movement
if (abs(targetX - shapeX) > 2.0) shapeX += (targetX > shapeX) ? 2.0 : -2.0;
else shapeX = targetX;
if (abs(targetY - shapeY) > 2.0) shapeY += (targetY > shapeY) ? 2.0 : -2.0;
else shapeY = targetY;
// Constrain position for larger shapes
shapeX = constrain(shapeX, 40, screenWidth - 40);
shapeY = constrain(shapeY, 40, screenHeight - 40);
// Update text display
if (isMoving) {
lastMoveTime = millis();
showText = false;
} else if (millis() - lastMoveTime >= TEXT_DELAY) {
showText = true;
}
// Draw content
if (showText) {
u8g2.setFont(u8g2_font_fub20_tf); // Larger font
u8g2.setDrawColor(1); // White text
const char* text = "Let's Dance";
int textWidth = u8g2.getStrWidth(text);
u8g2.drawStr((screenWidth - textWidth) / 2, centerY + 10, text); // Centered
} else {
// Blink shape
if (shapeVisible && millis() - lastBlink >= BLINK_ON) {
shapeVisible = false;
lastBlink = millis();
} else if (!shapeVisible && millis() - lastBlink >= BLINK_OFF) {
shapeVisible = true;
lastBlink = millis();
}
drawShape();
}
} else if (currentMode == GAME_MODE) {
// Game Mode OLED
if (inManualMode) {
// Manual mode eye movement
static char lastCommand = 'S';
if (pendingCmd != "") {
lastCommand = pendingCmd[0];
pendingCmd = "";
}
if (millis() - lastMoveTime >= moveInterval) {
switch (lastCommand) {
case 'F':
offsetY -= 1; // Eye moves up
break;
case 'L':
offsetX -= 1; // Eye moves left
break;
case 'R':
offsetX += 1; // Eye moves right
break;
default:
// No movement for backward or stop
break;
}
offsetX = constrain(offsetX, -10, 10);
offsetY = constrain(offsetY, -10, 10);
lastMoveTime = millis();
}
} else if (digitalRead(rmf) == LOW && digitalRead(rmb) == LOW && digitalRead(lmf) == LOW && digitalRead(lmb) == LOW) {
// Stopped state: eye blinks, moves in one direction, and centers
centerX = 90; // Center the eye
centerY = 70;
offsetX = 0;
offsetY = 0;
if (millis() - lastMoveTime >= moveInterval) {
offsetX += directionX;
if (offsetX > 10 || offsetX < -10) {
directionX = -directionX;
isBlinking = true;
}
lastMoveTime = millis();
}
} else {
// Line following: eye moves in a triangle
if (millis() - lastMoveTime >= moveInterval) {
static const int16_t trianglePoints[3][2] = {{97, 40}, {67, 100}, {127, 100}}; // Top, bottom-left, bottom-right
centerX = trianglePoints[triangleVertex][0];
centerY = trianglePoints[triangleVertex][1];
triangleVertex = (triangleVertex + 1) % 3;
offsetX = 0;
offsetY = 0;
lastMoveTime = millis();
}
}
// Handle blinking
if (isBlinking) {
drawGameEye(centerX + offsetX, centerY + offsetY, true);
blinkFrameCount++;
if (blinkFrameCount > blinkDuration) {
isBlinking = false;
blinkFrameCount = 0;
}
} else {
drawGameEye(centerX + offsetX, centerY + offsetY, false);
// Trigger faster blinks randomly
if (random(100) < 30) { // 30% chance per frame to blink
isBlinking = true;
blinkFrameCount = 0;
}
}
} else {
// Play Mode OLED (eye behavior)
int targetX = centerX;
int targetY = centerY;
float verticalOffset = 50;
if (currentRobotState == STOP) {
unsigned long currentTime = millis();
if (currentTime - lastIdleMove >= 1000) {
lastIdleMove = currentTime;
idleDirection++;
if (idleDirection > 8) idleDirection = 0;
}
if (idleDirection == 1) targetX = centerX - 25;
else if (idleDirection == 3) targetX = centerX + 25;
else if (idleDirection == 5) targetY = centerY - verticalOffset;
else if (idleDirection == 7) targetY = centerY + verticalOffset;
} else {
switch (currentRobotState) {
case FORWARD:  targetY = centerY - verticalOffset; break;
case BACKWARD: targetY = centerY + verticalOffset; break;
case LEFT:     targetX = centerX - 25; break;
case RIGHT:    targetX = centerX + 25; break;
default: break;
}
}
if (abs(targetX - currentX) > moveSpeed)
currentX += (targetX > currentX) ? moveSpeed : -moveSpeed;
else
currentX = targetX;
if (abs(targetY - currentY) > moveSpeed)
currentY += (targetY > currentY) ? moveSpeed : -moveSpeed;
else
currentY = targetY;
currentX = constrain(currentX, eyeballRadius, screenWidth - eyeballRadius);
currentY = constrain(currentY, eyeballRadius, screenHeight - eyeballRadius);
float eyeHeightRatio = 1.0f;
switch (blinkState) {
case OPEN:
blinkTimer += frameDelay;
if (blinkTimer > 400) { blinkTimer = 0; blinkState = CLOSING; }
break;
case CLOSING:
blinkTimer += frameDelay;
eyeHeightRatio = 1.0f - (float)blinkTimer / 80.0f;
if (eyeHeightRatio <= 0.0f) { eyeHeightRatio = 0.0f; blinkState = CLOSED; blinkTimer = 0; }
break;
case CLOSED:
blinkTimer += frameDelay;
eyeHeightRatio = 0.0f;
if (blinkTimer > 50) { blinkState = OPENING; blinkTimer = 0; }
break;
case OPENING:
blinkTimer += frameDelay;
eyeHeightRatio = (float)blinkTimer / 80.0f;
if (eyeHeightRatio >= 1.0f) { blinkState = OPEN; blinkTimer = 0; }
break;
}
drawEye(true, currentX, currentY, eyeHeightRatio);
}
u8g2.sendBuffer();
}
// ===== Game Mode Functions =====
// Game Mode Hand Servo Control
void handleHandServos() {
static unsigned long lastServoMove = 0;
static bool waveUp = true;
const unsigned long waveInterval = 1000; // Slower wave every 1000ms
if (millis() - lastServoMove >= waveInterval) {
if (waveUp) {
leftArmServo.write(45);  // Left hand wave up
rightArmServo.write(45);  // Right hand wave up
} else {
leftArmServo.write(135); // Left hand wave down
rightArmServo.write(135); // Right hand wave down
}
waveUp = !waveUp; // Toggle wave direction
lastServoMove = millis();
}
}
// Game Mode Obstacle Handler
void handleObstacle() {
stopMotors();
Serial.println("🚧 Obstacle detected");
if (!obstacleToggle) {
loadingBlueOnly(); // Blue loading animation during servo actions
loadingRed();
delay(1000);
gripperServo1.write(35);
delay(1500);
gripperServo2.write(180);
leftArmServo.write(45);  // Wave up
delay(500);
leftArmServo.write(135); // Wave down
delay(500);
leftArmServo.write(90);  // Return to neutral
delay(1000);
} else {
loadingYellowOnly(); // Yellow loading animation during servo actions
loadingRed();
delay(1000);
gripperServo2.write(0);
delay(1500);
gripperServo1.write(0);
rightArmServo.write(45);  // Wave up
delay(500);
rightArmServo.write(135); // Wave down
delay(500);
rightArmServo.write(90);  // Return to neutral
delay(1000);
moveBackwardGame();
delay(1300);
stopMotors();
}
obstacleToggle = !obstacleToggle; // Flip mode
}
// Game Mode Line Following
void lineFollowing() {
int sensorValues[NUM_SENSORS];
int error = 0, total = 0;
bool allSensorsLow = true;
// Read sensors
for (int i = 0; i < NUM_SENSORS; i++) {
sensorValues[i] = digitalRead(sensorPins[i]);
if (sensorValues[i] == HIGH) allSensorsLow = false;
}
// If line lost → stop
if (allSensorsLow) {
stopMotors();
rotatingColors();
return;
}
// Calculate error
for (int i = 0; i < NUM_SENSORS; i++) {
if (sensorValues[i] == HIGH) {
error += (i - 2) * 100;
total++;
}
}
if (total > 0) error /= total;
// PID control
integral += error;
float derivative = error - lastError;
float output = Kp * error + Ki * integral + Kd * derivative;
lastError = error;
int leftSpeed = constrain(baseSpeed - output, 0, 255);
int rightSpeed = constrain(baseSpeed + output, 0, 255);
// Apply motor control
if (error > 0) {
// Turn right
digitalWrite(rmf, HIGH);
digitalWrite(rmb, LOW);
digitalWrite(lmf, LOW);
digitalWrite(lmb, HIGH);
handleHandServos(); // Wave hands during movement
} else if (error < 0) {
// Turn left
digitalWrite(rmf, LOW);
digitalWrite(rmb, HIGH);
digitalWrite(lmf, HIGH);
digitalWrite(lmb, LOW);
handleHandServos(); // Wave hands during movement
} else {
// Forward
digitalWrite(rmf, HIGH);
digitalWrite(rmb, LOW);
digitalWrite(lmf, HIGH);
digitalWrite(lmb, LOW);
handleHandServos(); // Wave hands during movement
}
flashingBlueYellow(); // Blue and yellow flashing when line following
}
// Game Mode Movement Functions
void moveForwardGame() {
digitalWrite(rmf, HIGH);
digitalWrite(rmb, LOW);
digitalWrite(lmf, HIGH);
digitalWrite(lmb, LOW);
handleHandServos(); // Wave hands during movement
Serial.println("Forward");
loadingGreen(); // Green loading when moving forward in manual mode
}
void moveBackwardGame() {
digitalWrite(rmf, LOW);
digitalWrite(rmb, HIGH);
digitalWrite(lmf, LOW);
digitalWrite(lmb, HIGH);
handleHandServos(); // Wave hands during movement
Serial.println("Backward");
flashingRed(); // Flashing red when moving backward
}
void turnLeftGame() {
digitalWrite(lmf, LOW);
digitalWrite(lmb, LOW);
digitalWrite(rmf, HIGH);
digitalWrite(rmb, LOW);
handleHandServos(); // Wave hands during movement
Serial.println("Left");
flashingRed(); // Flashing red when turning left
}
void turnRightGame() {
digitalWrite(lmf, HIGH);
digitalWrite(lmb, LOW);
digitalWrite(rmf, LOW);
digitalWrite(rmb, LOW);
handleHandServos(); // Wave hands during movement
Serial.println("Right");
flashingRed(); // Flashing red when turning right
}
// Game Mode LED Effects
void rotatingColors() {
static uint8_t hue = 0;
for(int i = 0; i < NUM_LEDS; i++) {
leds[i] = CHSV((hue + (i * 255 / NUM_LEDS)) % 255, 255, 255);
}
hue += 5; // Rotate colors
}
void solidBlueYellow() {
for(int i = 0; i < NUM_LEDS; i++) {
if(i % 2 == 0) {
leds[i] = CRGB::Blue;
} else {
leds[i] = CRGB::Yellow;
}
}
}
void flashingBlueYellow() {
static bool isBlue = true;
static unsigned long lastFlash = 0;
const unsigned long flashInterval = 500; // Flash every 500ms
if (millis() - lastFlash >= flashInterval) {
isBlue = !isBlue; // Toggle color
lastFlash = millis();
}
fill_solid(leds, NUM_LEDS, isBlue ? CRGB::Blue : CRGB::Yellow);
}
void loadingBlueYellow() {
static uint8_t pos = 0;
fill_solid(leds, NUM_LEDS, CRGB::Black);
for(int i = 0; i < 4; i++) {
int index = (pos + i) % NUM_LEDS;
if(i % 2 == 0) {
leds[index] = CRGB::Blue;
} else {
leds[index] = CRGB::Yellow;
}
}
pos = (pos + 1) % NUM_LEDS;
}
