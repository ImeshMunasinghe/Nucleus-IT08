  pos = (pos + 1) % NUM_LEDS;
}

void forwardEffectPlay() {
  static int pos = 0;
  fill_solid(leds, NUM_LEDS, CRGB::Black);
  leds[pos] = CRGB::Green;
  leds[(pos + 1) % NUM_LEDS] = CRGB::White;
  FastLED.show();
  pos = (pos + 1) % NUM_LEDS;
}

void backwardEffectPlay() {
  static bool on = false;
  if (on) {
    fill_solid(leds, NUM_LEDS, CRGB::Red);
  } else {
    fill_solid(leds, NUM_LEDS, CRGB::Black);
  }
  on = !on;
  FastLED.show();
}

void turnEffectPlay() {
  static uint8_t brightness = 200;
  static int dir = 5;
  brightness += dir;
  if (brightness >= 255 || brightness <= 0) dir = -dir;
  fill_solid(leds, NUM_LEDS, CRGB(0, 0, brightness));
  FastLED.show();
}

// ===== Play Mode Arm Waving =====
void waveHandsPlay() {
  if (!waving) return;

  unsigned long currentTime = millis();
  if (currentTime - lastWaveTime >= 5) {  // Faster updates
    lastWaveTime = currentTime;

    servoPos += increment;
    if (servoPos >= 120 || servoPos <= 60) {
      increment = -increment;
    }

    leftArmServo.write(servoPos);
    rightArmServo.write(servoPos);
  }
}

