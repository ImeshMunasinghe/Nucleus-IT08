// Common get distance (with retry mechanism)
float getDistance() {
const int maxRetries = 3;
for (int i = 0; i < maxRetries; i++) {
digitalWrite(TRIG_PIN, LOW);
delayMicroseconds(2);
digitalWrite(TRIG_PIN, HIGH);
delayMicroseconds(10);
digitalWrite(TRIG_PIN, LOW);
long duration = pulseIn(ECHO_PIN, HIGH, 30000);
if (duration != 0) {
float distance = duration * 0.034 / 2;
Serial.printf("Ultrasonic Distance: %.2f cm\n", distance);
return distance;
}
Serial.println("Ultrasonic: No echo received, retrying...");
delay(10); // Short delay between retries
}
Serial.println("Ultrasonic: Failed to get valid reading");
return -1;
}
// ===== OLED Draw Eye (Parameterized for inversion) =====
void drawEye(bool inverted, float x, float y, float eyeHeightRatio) {
int16_t ix = (int16_t)x;
int16_t iy = (int16_t)y;
u8g2.setDrawColor(inverted ? 1 : 0);
u8g2.drawBox(0, 0, screenWidth, screenHeight);
u8g2.setDrawColor(inverted ? 0 : 1);
int ry = (int)(eyeballRadius * eyeHeightRatio);
if (ry < 1) ry = 1;
for (int16_t dy = -ry; dy <= ry; dy++) {
float dx = eyeballRadius * sqrt(1.0f - (dy * dy) / float(ry * ry));
int16_t left = ix - (int16_t)dx;
int16_t right = ix + (int16_t)dx;
if (left < 0) left = 0;
if (right >= screenWidth) right = screenWidth - 1;
int16_t yCoord = iy + dy;
if (yCoord < 0) yCoord = 0;
if (yCoord >= screenHeight) yCoord = screenHeight - 1;
u8g2.drawHLine(left, yCoord, right - left + 1);
}
}
// Game Mode OLED Eye Drawing
void drawGameEye(int16_t x, int16_t y, bool closed) {
u8g2.setDrawColor(1); // White for SH1107 OLED
if (!closed) {
// Open eye: filled white circle with radius 35
u8g2.drawDisc(x, y, 35, U8G2_DRAW_ALL);
} else {
// Closed eye: white horizontal line
u8g2.drawLine(x - 35, y, x + 35, y);
}
}
// ===== Entertainment Mode OLED Drawing Functions =====
void drawCircle(float x, float y) {
u8g2.drawDisc((int)x, (int)y, 30, U8G2_DRAW_ALL); // Larger radius
}
void drawHeart(float x, float y) {
// Scaled heart (~60x60 pixels)
u8g2.drawCircle((int)x - 15, (int)y - 15, 15, U8G2_DRAW_UPPER_LEFT | U8G2_DRAW_UPPER_RIGHT);
u8g2.drawCircle((int)x + 15, (int)y - 15, 15, U8G2_DRAW_UPPER_LEFT | U8G2_DRAW_UPPER_RIGHT);
u8g2.drawLine((int)x - 30, (int)y - 15, (int)x, (int)y + 30);
u8g2.drawLine((int)x + 30, (int)y - 15, (int)x, (int)y + 30);
}
void drawTriangle(float x, float y) {
// Larger equilateral triangle (~60x60 pixels)
int x1 = (int)x;
int y1 = (int)y - 30;
