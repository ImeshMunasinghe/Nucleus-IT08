// Digit Detection: Handle serial commands for testing
void handleSerialCommands() {
  if (Serial.available()) {
    String command = Serial.readString();
    command.trim();
    command.toLowerCase();
    if (command == "trigger" || command == "t") {
      manualTriggerRequested = true;
      Serial.println("\n🎯 MANUAL TRIGGER ACTIVATED!");
      SerialBT.println("Manual trigger activated");
      Serial.println("State: " + String(digitState));
      if (digitState == WAITING_FOR_FIRST_OBJECT) {
        Serial.println("→ Will simulate first object detection");
      } else if (digitState == WAITING_FOR_SECOND_OBJECT) {
        Serial.println("→ Will simulate second object detection");
      } else {
        Serial.println("→ System not waiting for objects");
        manualTriggerRequested = false;
      }
    } else if (command == "status" || command == "s") {
      Serial.println("\n📊 === DIGIT DETECTION STATUS ===");
      Serial.println("Current State: " + getDigitStateString(digitState));
      Serial.println("First Digit: " + (firstDigit != "" ? firstDigit : "Not captured"));
      Serial.println("Second Digit: " + (secondDigit != "" ? secondDigit : "Not captured"));
      Serial.println("ESP32-CAM IP: " + String(esp32cam_ip));
      Serial.println("WiFi Status: " + String(WiFi.status() == WL_CONNECTED ? "Connected" : "Disconnected"));
      if (WiFi.status() == WL_CONNECTED) {
        Serial.println("ESP32 IP: " + WiFi.localIP().toString());
      }
      Serial.println("Detection Distance: " + String(DETECTION_DISTANCE) + "cm");
      Serial.println("📊 === END STATUS ===\n");
      SerialBT.println("Digit Detection Status: " + getDigitStateString(digitState));
    } else if (command == "reset" || command == "r") {
      Serial.println("\n🔄 MANUAL DIGIT SYSTEM RESET");
      SerialBT.println("Manual digit system reset");
      resetDigitSystem();
    } else if (command == "test" || command == "distance") {
      Serial.println("\n📏 === DISTANCE TEST ===");
      for (int i = 0; i < 5; i++) {
        float dist = getDistance();
        Serial.println("Reading " + String(i+1) + ": " + String(dist) + " cm");
        delay(500);
      }
      Serial.println("📏 === TEST COMPLETE ===\n");
      SerialBT.println("Distance test completed");
    } else if (command == "clear" || command == "c") {
      Serial.println("\n🧹 MANUAL CAMERA BUFFER CLEAR");
      SerialBT.println("Manual camera buffer clear");
      Serial.println("Requesting ESP32-CAM to clear buffer...");
      HTTPClient http;
      String url = "http://" + String(esp32cam_ip) + "/capture";
      http.begin(url);
      http.setTimeout(10000);
      int code = http.GET();
      http.end();
      Serial.println("Buffer clear request sent: " + String(code));
      Serial.println("🧹 === CLEAR COMPLETE ===\n");
      SerialBT.println("Camera buffer cleared");
    } else if (command == "help" || command == "h") {
      Serial.println("\n🎮 === DIGIT DETECTION TESTING COMMANDS ===");
      Serial.println("'trigger' or 't' - Manually trigger object detection");
      Serial.println("'status' or 's'  - Show current digit detection status");
      Serial.println("'reset' or 'r'   - Reset digit detection system");
      Serial.println("'test'           - Test ultrasonic sensor readings");
      Serial.println("'clear' or 'c'   - Manually clear camera buffer");
      Serial.println("'help' or 'h'    - Show this help menu");
      Serial.println("🎮 === COMMANDS READY ===\n");
      SerialBT.println("Digit detection testing commands listed");
    } else if (command != "") {
      Serial.println("❌ Unknown command: '" + command + "'");
      Serial.println("Type 'help' for available commands");
      SerialBT.println("Unknown digit detection command");
    }
  }
}

// Digit Detection: Get state string
String getDigitStateString(DigitSystemState state) {
  switch (state) {
    case WAITING_FOR_FIRST_OBJECT: return "WAITING_FOR_FIRST_OBJECT";
    case PROCESSING_FIRST_DIGIT: return "PROCESSING_FIRST_DIGIT";
    case WAITING_FOR_SECOND_OBJECT: return "WAITING_FOR_SECOND_OBJECT";
    case PROCESSING_SECOND_DIGIT: return "PROCESSING_SECOND_DIGIT";
    case COMPARISON_COMPLETE: return "COMPARISON_COMPLETE";
    default: return "UNKNOWN";
  }
}

// ===== OLED Draw Eye (Parameterized for inversion) =====
void drawEye(bool inverted, float x, float y, float eyeHeightRatio) {
  int16_t ix = (int16_t)x;
  int16_t iy = (int16_t)y;

  u8g2.setDrawColor(inverted ? 1 : 0);
  u8g2.drawBox(0, 0, screenWidth, screenHeight);

  u8g2.setDrawColor(inverted ? 0 : 1);
  int ry = (int)(eyeballRadius * eyeHeightRatio);
  if (ry < 1) ry = 1;
  for (int16_t dy = -ry; dy <= ry; dy++) {
    float dx = eyeballRadius * sqrt(1.0f - (dy * dy) / float(ry * ry));
    int16_t left = ix - (int16_t)dx;
    int16_t right = ix + (int16_t)dx;
    if (left < 0) left = 0;
    if (right >= screenWidth) right = screenWidth - 1;
    int16_t yCoord = iy + dy;
    if (yCoord < 0) yCoord = 0;
    if (yCoord >= screenHeight) yCoord = screenHeight - 1;
    u8g2.drawHLine(left, yCoord, right - left + 1);
  }
}

