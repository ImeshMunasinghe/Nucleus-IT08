void drawHeart(float x, float y) {
  u8g2.drawCircle((int)x - 15, (int)y - 15, 15, U8G2_DRAW_UPPER_LEFT | U8G2_DRAW_UPPER_RIGHT);
  u8g2.drawCircle((int)x + 15, (int)y - 15, 15, U8G2_DRAW_UPPER_LEFT | U8G2_DRAW_UPPER_RIGHT);
  u8g2.drawLine((int)x - 30, (int)y - 15, (int)x, (int)y + 30);
  u8g2.drawLine((int)x + 30, (int)y - 15, (int)x, (int)y + 30);
}

void drawTriangle(float x, float y) {
  int x1 = (int)x;
  int y1 = (int)y - 30;
  int x2 = (int)x - 30;
  int y2 = (int)y + 30;
  int x3 = (int)x + 30;
  int y3 = (int)y + 30;
  u8g2.drawTriangle(x1, y1, x2, y2, x3, y3);
