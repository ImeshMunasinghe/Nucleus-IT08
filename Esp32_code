std::map<int, unsigned long> lastPulseMap;
std::map<int, bool> motorStateMap;
#define digitalWrite_original digitalWrite
void speedDigitalWrite(int pin, int state) {
unsigned long &lastPulse = lastPulseMap[pin];
bool &motorState = motorStateMap[pin];
unsigned long now = millis();
int onTime = motorSpeed;
int offTime = 100 - motorSpeed;
if (state == HIGH && motorSpeed < 100) {
if (motorState) {
if (now - lastPulse >= onTime) {
digitalWrite_original(pin, LOW);
motorState = false;
lastPulse = now;
} else digitalWrite_original(pin, HIGH);
} else {
if (now - lastPulse >= offTime) {
digitalWrite_original(pin, HIGH);
motorState = true;
lastPulse = now;
} else digitalWrite_original(pin, LOW);
}
} else digitalWrite_original(pin, state);
}
#undef digitalWrite
#define digitalWrite(pin, state) speedDigitalWrite(pin, state)
