// ===== Execute Game Mode =====
void executeGameMode() {
  float distance = getDistance();

  // Ultrasonic sensor obstacle handling (10 cm)
  if (!turning && distance > 0 && distance <= 10 && distance > DETECTION_DISTANCE && currentRobotState != STOP) {
    stopNowGame();
    SerialBT.println("Obstacle detected in Game Mode at 10cm!");
    turnRightGame();
    turning = true;
    turnStartTime = millis();
  }
  if (turning && millis() - turnStartTime >= 100) {
    stopNowGame();
    turning = false;
  }

  // Digit detection for close proximity (≤ 5 cm)
  if (distance > 0 && distance <= DETECTION_DISTANCE) {
    stopNowGame();
    SerialBT.println("Close obstacle detected at 5cm! Initiating digit detection...");
    gameSubMode = DIGIT_DETECTION;
  }

  if (gameSubMode == DIGIT_DETECTION) {
    handleSerialCommands();
    switch (digitState) {
      case WAITING_FOR_FIRST_OBJECT:
        if (detectObject() || manualTriggerRequested) {
          if (manualTriggerRequested) {
            Serial.println("MANUAL TRIGGER: First object simulation! Capturing and processing...");
            SerialBT.println("Manual trigger: First object simulation");
            manualTriggerRequested = false;
          } else {
            Serial.println("First object detected! Capturing and processing...");
            SerialBT.println("First object detected");
          }
          digitState = PROCESSING_FIRST_DIGIT;
          blinkLED(SUCCESS_LED, 2);
        }
        break;
      case PROCESSING_FIRST_DIGIT:
        firstDigit = captureAndProcessDigit();
        if (firstDigit != "") {
          Serial.println("First digit captured: " + firstDigit);
          SerialBT.println("First digit: " + firstDigit);
          Serial.println("Drive to second signpost...");
          digitState = WAITING_FOR_SECOND_OBJECT;
          blinkLED(SUCCESS_LED, 3);
          delay(2000);
        } else {
          Serial.println("Failed to capture first digit. Retrying...");
          SerialBT.println("Failed to capture first digit");
          digitState = WAITING_FOR_FIRST_OBJECT;
          blinkLED(ERROR_LED, 2);
          delay(1000);
        }
        break;
      case WAITING_FOR_SECOND_OBJECT:
        if (detectObject() || manualTriggerRequested) {
          if (manualTriggerRequested) {
            Serial.println("MANUAL TRIGGER: Second object simulation! Capturing and processing...");
            SerialBT.println("Manual trigger: Second object simulation");
            manualTriggerRequested = false;
          } else {
            Serial.println("Second object detected! Capturing and processing...");
            SerialBT.println("Second object detected");
          }
          digitState = PROCESSING_SECOND_DIGIT;
          blinkLED(SUCCESS_LED, 2);
        }
        break;
      case PROCESSING_SECOND_DIGIT:
        secondDigit = captureAndProcessDigit();
        if (secondDigit != "") {
          Serial.println("Second digit captured: " + secondDigit);
          SerialBT.println("Second digit: " + secondDigit);
          digitState = COMPARISON_COMPLETE;
        } else {
          Serial.println("Failed to capture second digit. Retrying...");
          SerialBT.println("Failed to capture second digit");
          digitState = WAITING_FOR_SECOND_OBJECT;
          blinkLED(ERROR_LED, 2);
          delay(1000);
        }
        break;
      case COMPARISON_COMPLETE:
        compareDigits();
        delay(5000);
        resetDigitSystem();
        gameSubMode = LINE_FOLLOWING;
        firstObstacle = true;
        SerialBT.println("Returning to LINE FOLLOWING mode");
        break;
    }
    updateOLED();
    return;
  }

  int s1 = digitalRead(S1);
  int s2 = digitalRead(S2);
  int s3 = digitalRead(S3);
  int s4 = digitalRead(S4);
  int s5 = digitalRead(S5);

  if (gameSubMode == LINE_FOLLOWING) {
    if (s1 == LOW && s2 == LOW && s3 == LOW && s4 == LOW && s5 == LOW) {
      stopNowGame();
      gameSubMode = MANUAL;
      SerialBT.println("Switched to MANUAL mode");
    } else if (s3 == LOW) goForwardGame();
    else if ((s2 == LOW && s1 == HIGH) || s1 == LOW) turnLeftGame();
    else if ((s4 == LOW && s5 == HIGH) || s5 == LOW) turnRightGame();
    else if ((s2 == LOW && s3 == HIGH) || (s4 == LOW && s3 == HIGH)) {
      if (s2 == LOW) turnLeftGame();
      if (s4 == LOW) turnRightGame();
    }
  } else if (gameSubMode == MANUAL) {
    if (pendingCmd != "") {
      String cmd = pendingCmd;
      pendingCmd = "";
      cmd.trim();
      Serial.printf("Game Mode: Processing Command = %s\n", cmd.c_str());
      if (cmd == "F") { goForwardGame(); SerialBT.println("Moving Forward"); }
      else if (cmd == "B") { goBackwardGame(); SerialBT.println("Moving Backward"); }
      else if (cmd == "L") { turnLeftGame(); SerialBT.println("Turning Left"); }
      else if (cmd == "R") { turnRightGame(); SerialBT.println("Turning Right"); }
      else if (cmd == "S") { stopNowGame(); SerialBT.println("Stopped"); }
      else if (cmd == "AUTO") { gameSubMode = LINE_FOLLOWING; SerialBT.println("LINE FOLLOWING"); }
      else if (cmd.startsWith("SPD")) {
        int spd = cmd.substring(3).toInt();
        if (spd >= 0 && spd <= 100) { motorSpeed = spd; SerialBT.printf("Speed %d%%\n", motorSpeed); }
        else SerialBT.println("0-100 only");
      } else SerialBT.println("Unknown cmd");
      delay(1000);
      stopNowGame();
      gameSubMode = LINE_FOLLOWING;
      SerialBT.println("Returning to LINE FOLLOWING mode after manual command");
    }
  }

  updateOLED();
  delay(frameDelay);
}

// ===== Execute Play Mode =====
void executePlayMode() {
  static unsigned long lastDebug = 0;
  if (millis() - lastDebug >= 1000) {
    String stateStr;
    switch (currentRobotState) {
      case STOP: stateStr = "STOP"; break;
      case FORWARD: stateStr = "FORWARD"; break;
      case BACKWARD: stateStr = "BACKWARD"; break;
      case LEFT: stateStr = "LEFT"; break;
      case RIGHT: stateStr = "RIGHT"; break;
    }
    Serial.printf("Play Mode: Current State = %s, Distance = %.2f

 cm\n", stateStr.c_str(), getDistance());
    lastDebug = millis();
  }

  if (pendingCmd != "") {
    String cmd_str = pendingCmd;
    pendingCmd = "";
    cmd_str.trim();
    Serial.printf("Play Mode: Received Command = %s\n", cmd_str.c_str());
    if (cmd_str.length() == 1) {
      char cmd = cmd_str[0];
      switch (cmd) {
        case 'f': moveForwardPlay(); SerialBT.println("Moving Forward"); break;
        case 'b': moveBackwardPlay(); SerialBT.println("Moving Backward"); break;
        case 'l': turnLeftPlay(); neutralArms(); SerialBT.println("Turning Left"); break;
        case 'r': turnRightPlay(); neutralArms(); SerialBT.println("Turning Right"); break;
        case 's': stopMotorsPlay(); neutralArms(); SerialBT.println("Stopped"); break;
        default: SerialBT.println("Unknown command"); Serial.println("Play Mode: Unknown command ignored"); break;
      }
    } else {
      SerialBT.println("Unknown command");
      Serial.println("Play Mode: Invalid command length, ignored");
    }
  }

  float distance = getDistance();
  if (!turning && distance > 0 && distance <= 10 && currentRobotState != STOP) {
    stopMotorsPlay();
    SerialBT.println("Obstacle detected in Play Mode!");
    Serial.println("Play Mode: Obstacle detected, stopping and turning right");
    turnRightPlay();
    turning = true;
    turnStartTime = millis();
  }
  if (turning && millis() - turnStartTime >= 100) {
    Serial.println("Play Mode: Resuming previous state after turn");
    switch (currentRobotState) {
      case FORWARD: moveForwardPlay(); break;
      case BACKWARD: moveBackwardPlay(); break;
      case LEFT: turnLeftPlay(); neutralArms(); break;
      case RIGHT: turnRightPlay(); neutralArms(); break;
      case STOP: stopMotorsPlay(); neutralArms(); break;
    }
    turning = false;
  }

  switch (currentRobotState) {
    case FORWARD: moveForwardPlay(); break;
    case BACKWARD: moveBackwardPlay(); break;
    case LEFT: turnLeftPlay(); neutralArms(); break;
    case RIGHT: turnRightPlay(); neutralArms(); break;
    case STOP: stopMotorsPlay(); neutralArms(); break;
  }

  waveHandsPlay();
  switch (currentRobotState) {
    case STOP: loadingEffectPlay(); break;
    case FORWARD: forwardEffectPlay(); break;
    case BACKWARD: backwardEffectPlay(); break;
    case LEFT:
    case RIGHT: turnEffectPlay(); break;
  }

  updateOLED();
  delay(frameDelay);
}

// ===== Execute Entertainment Mode =====
void executeEntertainmentMode() {
  if (millis() - danceStartTime >= DANCE_DURATION) {
    danceMode = (danceMode == 1) ? 2 : 1;
    danceStartTime = millis();
    Serial.printf("Entertainment Mode: Switching to Dance %d\n", danceMode);
    SerialBT.printf("Switching to Dance %d\n", danceMode);
  }

  if (currentMove != STOPPED_E) {
    updateLEDPattern();
    updateServoMotion();
  } else {
    FastLED.clear();
    FastLED.show();
    leftArmServo.write(90);
    rightArmServo.write(90);
  }

  updateOLED();
  if (danceMode == 1) {
    danceRoutine1();
  } else {
    danceRoutine2();
  }
  delay(frameDelay);
}

// ===== Setup =====
void setup() {
  Serial.begin(115200);
  Serial.println("Unified Robot Starting...");

  // Pin modes
  pinMode(RMF, OUTPUT); pinMode(RMB, OUTPUT);
  pinMode(LMF, OUTPUT); pinMode(LMB, OUTPUT);
  pinMode(S1, INPUT); pinMode(S2, INPUT); pinMode(S3, INPUT);
  pinMode(S4, INPUT); pinMode(S5, INPUT);
  pinMode(TRIG_PIN, OUTPUT pinMode(ECHO_PIN, INPUT);
  pinMode(STATUS_LED, OUTPUT); pinMode(SUCCESS_LED, OUTPUT); pinMode(ERROR_LED, OUTPUT);

  // Initialize digit detection LEDs
  digitalWrite(STATUS_LED, HIGH);
  digitalWrite(SUCCESS_LED, LOW);
  digitalWrite(ERROR_LED, LOW);

  // Servos
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
  gripperServo1.setPeriodHertz(50);
  gripperServo2.setPeriodHertz(50);
  leftArmServo.setPeriodHertz(50);
  rightArmServo.setPeriodHertz(50);
  gripperServo1.attach(SERVO_GRIPPER1_PIN, 500, 2400); gripperServo1.write(0);
  gripperServo2.attach(SERVO_GRIPPER2_PIN, 500, 2400); gripperServo2.write(0);
  leftArmServo.attach(SERVO_LEFT_ARM_PIN, 500, 2400); leftArmServo.write(90);
  rightArmServo.attach(SERVOE_RIGHT_ARM_PIN, 500, 2400); rightArmServo.write(90);

  // Bluetooth Serial
  SerialBT.begin("ESP32_SPEAKER");
  Serial.println("Bluetooth initialized: ESP32_SPEAKER");

  // WiFi for digit detection
  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
    digitalWrite(STATUS_LED, !digitalRead(STATUS_LED));
  }
  digitalWrite(STATUS_LED, HIGH);
  Serial.println();
  Serial.println("WiFi connected!");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  // LEDs
  FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS);
  FastLED.setBrightness(BRIGHTNESS);
  clearLEDs();

  // OLED
  Wire.begin(21, 22);
  u8g2.begin();

  // Audio
  auto cfg = i2s.defaultConfig();
  cfg.pin_bck  = 12;
  cfg.pin_ws   = 13;
  cfg.pin_data = 26;
  i2s.begin(cfg);
  a2dp_sink.set_on_connection_state_changed(connection_state_changed);
  a2dp_sink.start("ESP32_SPEAKER");
  a2dp_sink.set_volume(0x7F);

  // Initial mode
  switchToGameMode();
  Serial.println("Robot Ready!");
  Serial.println("Detection distance: 5cm");
  Serial.println("\n🎮 MANUAL TESTING MODE ENABLED");
  Serial.println("Type 'help' in Serial Monitor for digit detection testing commands");
  delay(1000);
}

// ===== Main Loop =====
void loop() {
  static unsigned long lastStatusCheck = 0;
  if (millis() - lastStatusCheck >= 1000) {
    String modeStr;
    switch (currentMode) {
      case GAME_MODE: modeStr = "GAME_MODE"; break;
      case PLAY_MODE: modeStr = "PLAY_MODE"; break;
      case ENTERTAINMENT_MODE: modeStr = "ENTERTAINMENT_MODE"; break;
    }
    Serial.printf("Current Mode: %s, Bluetooth Status: %s\n", 
                  modeStr.c_str(), 
                  SerialBT.connected() ? "Connected" : "Disconnected");
    if (gameSubMode == DIGIT_DETECTION) {
      Serial.printf("Digit Detection State: %s\n", getDigitStateString(digitState).c_str());
    }
    lastStatusCheck = millis();
  }

  if (SerialBT.available()) {
    String cmd = SerialBT.readStringUntil('\n');
    if (cmd.length() > SEO) {
      Serial.printf("Main Loop: Bluetooth Raw Command = '%s' (length = %d)\n", cmd.c_str(), cmd.length());
      cmd.trim();
      Serial.printf("Main Loop: Bluetooth Trimmed Command = '%s'\n", cmd.c_str());
      if (cmd == "G") {
        Serial.println("Main Loop: Switching to Game Mode via Bluetooth");
        switchToGameMode();
        SerialBT.println("Game Mode Activated");
      } else if (cmd == "M") {
        Serial.println("Main Loop: Switching to Play Mode via Bluetooth");
        switchToPlayMode();
        SerialBT.println("Play Mode Activated");
      } else if (cmd == "E") {
        Serial.println("Main Loop: Switching to Entertainment Mode via Bluetooth");
        switchToEntertainmentMode();
        SerialBT.println("Entertainment Mode Activated - Let's Dance!");
      } else {
        Serial.printf("Main Loop: Passing Bluetooth command '%s' to mode handler\n", cmd.c_str());
        pendingCmd = cmd;
      }
    } else {
      Serial.println("Main Loop: Empty Bluetooth command received, ignoring");
    }
  }

  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    if (cmd.length() > 0) {
      Serial.printf("Main Loop: USB Serial Raw Command = '%s' (length = %d)\n", cmd.c_str(), cmd.length());
      cmd.trim();
      Serial.printf("Main Loop: USB Serial Trimmed Command = '%s'\n", cmd.c_str());
      if (cmd == "G") {
        Serial.println("Main Loop: Switching to Game Mode via USB Serial");
        switchToGameMode();
        SerialBT.println("Game Mode Activated");
        Serial.println("Game Mode Activated");
      } else if (cmd == "M") {
        Serial.println("Main Loop: Switching to Play Mode via USB Serial");
        switchToPlayMode();
        SerialBT.println("Play Mode Activated");
        Serial.println("Play Mode Activated");
      } else if (cmd == "E") {
        Serial.println("Main Loop: Switching to Entertainment Mode via USB Serial");
        switchToEntertainmentMode();
        SerialBT.println("Entertainment Mode Activated - Let's Dance!");
        Serial.println("Entertainment Mode Activated");
      } else {
        Serial.printf("Main Loop: Passing USB Serial command '%s' to mode handler\n", cmd.c_str());
        pendingCmd = cmd;
      }
    } else {
      Serial.println("Main Loop: Empty USB Serial command received, ignoring");
    }
  }

  if (currentMode == GAME_MODE) {
    executeGameMode();
  } else if (currentMode == PLAY_MODE) {
    executePlayMode();
  } else if (currentMode == ENTERTAINMENT_MODE) {
    executeEntertainmentMode();
  }
}
