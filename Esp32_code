// ===== Game Mode Line Following =====
void lineFollowing() {
  int sensorValues[NUM_SENSORS];
  int error = 0, total = 0;
  bool allSensorsLow = true;

  // Read sensors
  for (int i = 0; i < NUM_SENSORS; i++) {
    sensorValues[i] = digitalRead(sensorPins[i]);
    if (sensorValues[i] == HIGH) allSensorsLow = false;
  }

  // If line lost → stop
  if (allSensorsLow) {
    stopNowGame();
    rotatingColors(); // Five colors rotating
    gameSubMode = MANUAL;
    SerialBT.println("Switched to MANUAL mode");
    return;
  }

  // Calculate error
  for (int i = 0; i < NUM_SENSORS; i++) {
    if (sensorValues[i] == HIGH) {
      error += (i - 2) * 100;
      total++;
    }
  }
  if (total > 0) error /= total;

  // PID control
  integral += error;
  float derivative = error - lastError;
  float output = Kp * error + Ki * integral + Kd * derivative;
  lastError = error;

  int leftSpeed = constrain(baseSpeed - output, 0, 255);
  int rightSpeed = constrain(baseSpeed + output, 0, 255);

  // Apply motor control
  if (error > 0) {
    // Turn right
    digitalWrite(RMF, HIGH);
    digitalWrite(RMB, LOW);
    digitalWrite(LMF, LOW);
    digitalWrite(LMB, HIGH);
    handleHandServos(); // Wave hands during movement
    currentRobotState = RIGHT;
  } else if (error < 0) {
    // Turn left
    digitalWrite(RMF, LOW);
    digitalWrite(RMB, HIGH);
    digitalWrite(LMF, HIGH);
    digitalWrite(LMB, LOW);
    handleHandServos(); // Wave hands during movement
    currentRobotState = LEFT;
  } else {
    // Forward
    digitalWrite(RMF, HIGH);
    digitalWrite(RMB, LOW);
    digitalWrite(LMF, HIGH);
    digitalWrite(LMB, LOW);
    handleHandServos(); // Wave hands during movement
    currentRobotState = FORWARD;
  }
  flashingBlueYellow(); // Blue and yellow flashing when line following
}

// ===== OLED Draw Eye (Parameterized for inversion, used in Play Mode) =====
void drawEye(bool inverted, float x, float y, float eyeHeightRatio) {
  int16_t ix = (int16_t)x;
  int16_t iy = (int16_t)y;

  u8g2.setDrawColor(inverted ? 1 : 0);
  u8g2.drawBox(0, 0, screenWidth, screenHeight);

  u8g2.setDrawColor(inverted ? 0 : 1);
  int ry = (int)(eyeballRadius * eyeHeightRatio);
  if (ry < 1) ry = 1;
  for (int16_t dy = -ry; dy <= ry; dy++) {
    float dx = eyeballRadius * sqrt(1.0f - (dy * dy) / float(ry * ry));
    int16_t left = ix - (int16_t)dx;
    int16_t right = ix + (int16_t)dx;
    if (left < 0) left = 0;
    if (right >= screenWidth) right = screenWidth - 1;
    int16_t yCoord = iy + dy;
    if (yCoord < 0) yCoord = 0;
    if (yCoord >= screenHeight) yCoord = screenHeight - 1;
    u8g2.drawHLine(left, yCoord, right - left + 1);
  }
}

