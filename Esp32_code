// Common get distance (combined with timeout handling)
float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return -1;
  return duration * 0.034 / 2;
}

// ===== OLED Draw Eye (Parameterized for inversion) =====
void drawEye(bool inverted, float x, float y, float eyeHeightRatio) {
  int16_t ix = (int16_t)x;
  int16_t iy = (int16_t)y;

  u8g2.setDrawColor(inverted ? 1 : 0);
  u8g2.drawBox(0, 0, screenWidth, screenHeight);

  u8g2.setDrawColor(inverted ? 0 : 1);
  int ry = (int)(eyeballRadius * eyeHeightRatio);
  if (ry < 1) ry = 1;
  for (int16_t dy = -ry; dy <= ry; dy++) {
    float dx = eyeballRadius * sqrt(1.0f - (dy * dy) / float(ry * ry));
    int16_t left = ix - (int16_t)dx;
    int16_t right = ix + (int16_t)dx;
    if (left < 0) left = 0;
    if (right >= screenWidth) right = screenWidth - 1;
    int16_t yCoord = iy + dy;
    if (yCoord < 0) yCoord = 0;
    if (yCoord >= screenHeight) yCoord = screenHeight - 1;
    u8g2.drawHLine(left, yCoord, right - left + 1);
  }
}

// ===== Entertainment Mode OLED Drawing Functions =====
void drawCircle(float x, float y) {
  u8g2.drawDisc((int)x, (int)y, 30, U8G2_DRAW_ALL); // Larger radius
}

void drawHeart(float x, float y) {
  u8g2.drawCircle((int)x - 15, (int)y - 15, 15, U8G2_DRAW_UPPER_LEFT | U8G2_DRAW_UPPER_RIGHT);
  u8g2.drawCircle((int)x + 15, (int)y - 15, 15, U8G2_DRAW_UPPER_LEFT | U8G2_DRAW_UPPER_RIGHT);
  u8g2.drawLine((int)x - 30, (int)y - 15, (int)x, (int)y + 30);
  u8g2.drawLine((int)x + 30, (int)y - 15, (int)x, (int)y + 30);
}

void drawTriangle(float x, float y) {
  int x1 = (int)x;
  int y1 = (int)y - 30;
  int x2 = (int)x - 30;
  int y2 = (int)y + 30;
  int x3 = (int)x + 30;
  int y3 = (int)y + 30;
  u8g2.drawTriangle(x1, y1, x2, y2, x3, y3);
}

void drawShape() {
  if (!shapeVisible) return;
  u8g2.setDrawColor(1); // White shape
  switch (currentShape) {
    case CIRCLE: drawCircle(shapeX, shapeY); break;
    case HEART: drawHeart(shapeX, shapeY); break;
    case TRIANGLE: drawTriangle(shapeX, shapeY); break;
  }
}

// ===== OLED Update (Mode-specific behavior) =====
void updateOLED() {
  u8g2.clearBuffer();

  if (currentMode == ENTERTAINMENT_MODE) {
    u8g2.setDrawColor(0);
    u8g2.drawBox(0, 0, screenWidth, screenHeight); // Black background

    if (startupAnimation) {
      u8g2.setFont(u8g2_font_fub20_tf);
      u8g2.setDrawColor(1); // White text
      const char* text = "Let's Dance";
      u8g2.drawStr((int)textX, centerY + 10, text);
      textX -= textSpeed;
      if (textX < -100) {
        startupAnimation = false;
        shapeX = centerX;
        shapeY = centerY;
      }
      u8g2.sendBuffer();
      return;
    }

    if (millis() - lastShapeSwitch >= SHAPE_SWITCH_INTERVAL) {
      currentShape = (ShapeType)((currentShape + 1) % 3);
      lastShapeSwitch = millis();
    }

    float targetX = shapeX;
    float targetY = shapeY;
    bool isMoving = false;
    if (currentMove == STOPPED_E) {
      if (millis() - lastIdleMove >= 1000) {
        lastIdleMove = millis();
        idleDirection = random(4);
      }
      switch (idleDirection) {
        case 0: targetX -= 2.0; isMoving = true; break;
        case 1: targetX += 2.0; isMoving = true; break;
        case 2: targetY -= 2.0; isMoving = true; break;
        case 3: targetY += 2.0; isMoving = true; break;
      }
    } else {
      switch (currentMove) {
        case FORWARD_E: targetY -= 2.0; isMoving = true; break;
        case BACKWARD_E: targetY += 2.0; isMoving = true; break;
        case TURN_LEFT_E: targetX -= 2.0; isMoving = true; break;
        case TURN_RIGHT_E: targetX += 2.0; isMoving = true; break;
        case SPIN_E: targetX += 2.0; isMoving = true; break;
        default: break;
      }
    }

    if (abs(targetX - shapeX) > 2.0) shapeX += (targetX > shapeX) ? 2.0 : -2.0;
    else shapeX = targetX;
    if (abs(targetY - shapeY) > 2.0) shapeY += (targetY > shapeY) ? 2.0 : -2.0;
    else shapeY = targetY;

    shapeX = constrain(shapeX, 40, screenWidth - 40);
    shapeY = constrain(shapeY, 40, screenHeight - 40);

    if (isMoving) {
      lastMoveTime = millis();
      showText = false;
    } else if (millis() - lastMoveTime >= TEXT_DELAY) {
      showText = true;
    }

    if (showText) {
      u8g2.setFont(u8g2_font_fub20_tf);
      u8g2.setDrawColor(1);
      const char* text = "Let's Dance";
      int textWidth = u8g2.getStrWidth(text);
      u8g2.drawStr((screenWidth - textWidth) / 2, centerY + 10, text);
    } else {
      if (shapeVisible && millis() - lastBlink >= BLINK_ON) {
        shapeVisible = false;
        lastBlink = millis();
      } else if (!shapeVisible && millis() - lastBlink >= BLINK_OFF) {
        shapeVisible = true;
        lastBlink = millis();
      }
      drawShape();
    }
  } else {
    int targetX = centerX;
    int targetY = centerY;

    int openBlinkThreshold = (currentMode == GAME_MODE) ? 500 : 400;
    float verticalOffset = (currentMode == GAME_MODE) ? 40 : 50;

    if (currentRobotState == STOP && currentMode == PLAY_MODE) {
      unsigned long currentTime = millis();
      if (currentTime - lastIdleMove >= 1000) {
        lastIdleMove = currentTime;
        idleDirection++;
        if (idleDirection > 8) idleDirection = 0;
      }

      if (idleDirection == 1) targetX = centerX - 25;
      else if (idleDirection == 3) targetX = centerX + 25;
      else if (idleDirection == 5) targetY = centerY - verticalOffset;
      else if (idleDirection == 7) targetY = centerY + verticalOffset;
    } else {
      switch (currentRobotState) {
        case FORWARD:  targetY = centerY - verticalOffset; break;
        case BACKWARD: targetY = centerY + verticalOffset; break;
        case LEFT:     targetX = centerX - 25; break;
        case RIGHT:    targetX = centerX + 25; break;
        default: break;
      }
    }

    if (abs(targetX - currentX) > moveSpeed)
      currentX += (targetX > currentX) ? moveSpeed : -moveSpeed;
    else
      currentX = targetX;

    if (abs(targetY - currentY) > moveSpeed)
      currentY += (targetY > currentY) ? moveSpeed : -moveSpeed;
    else
      currentY = targetY;

    currentX = constrain(currentX, eyeballRadius, screenWidth - eyeballRadius);
    currentY = constrain(currentY, eyeballRadius, screenHeight - eyeballRadius);

    float eyeHeightRatio = 1.0f;
    switch (blinkState) {
      case OPEN:
        blinkTimer += frameDelay;
        if (blinkTimer > openBlinkThreshold) { blinkTimer = 0; blinkState = CLOSING; }
        break;
      case CLOSING:
        blinkTimer += frameDelay;
        eyeHeightRatio = 1.0f - (float)blinkTimer / 80.0f;
        if (eyeHeightRatio <= 0.0f) { eyeHeightRatio = 0.0f; blinkState = CLOSED; blinkTimer = 0; }
        break;
      case CLOSED:
        blinkTimer += frameDelay;
        eyeHeightRatio = 0.0f;
        if (blinkTimer > 50) { blinkState = OPENING; blinkTimer = 0; }
        break;
      case OPENING:
        blinkTimer += frameDelay;
        eyeHeightRatio = (float)blinkTimer / 80.0f;
        if (eyeHeightRatio >= 1.0f) { blinkState = OPEN; blinkTimer = 0; }
        break;
    }

    drawEye(currentMode == PLAY_MODE, currentX, currentY, eyeHeightRatio);
  }
  
  u8g2.sendBuffer();
}

// ===== Game Mode LED Functions =====
void showYellowBlueGame() {
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = (i % 2 == 0) ? CRGB::Yellow : CRGB::Blue;
  }
  FastLED.show();
}

void showFiveColorsGame() {
  CRGB colors[5] = {CRGB::Red, CRGB::Yellow, CRGB::Blue, CRGB::Green, CRGB::Purple};
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = colors[i % 5];
  }
  FastLED.show();
}

void loadingPatternGame(CRGB color, int loops = 2) {
  for (int l = 0; l < loops; l++) {
    for (int i = 0; i < NUM_LEDS; i++) {
      leds[i] = color;
      FastLED.show();
      delay(40);
      leds[i] = CRGB::Black;
    }
  }
}

void sequenceColorsLoadingGame() {
  CRGB colors[5] = {CRGB::Red, CRGB::Yellow, CRGB::Blue, CRGB::Green, CRGB::Purple};
  for (int c = 0; c < 5; c++) {
    loadingPatternGame(colors[c], 1);
  }
}

// Blink solid color without blocking movement
void updateManualBlink() {
  if (manualBlinkColor != CRGB::Black) {
    unsigned long now = millis();
    if (now - lastBlinkLED > blinkInterval) {
      lastBlinkLED = now;
      blinkStateLED = !blinkStateLED;
      if (blinkStateLED)
        fill_solid(leds, NUM_LEDS, manualBlinkColor);
      else
        fill_solid(leds, NUM_LEDS, CRGB::Black);
      FastLED.show();
    }
  }
}

// ===== Game Mode Arm Update =====
void updateHands() {
  if (currentRobotState == FORWARD || currentRobotState == BACKWARD ||
      currentRobotState == LEFT || currentRobotState == RIGHT) {
    unsigned long now = millis();
    float angleAmplitude = 60;
    float speed = 0.004;
    float angle = angleAmplitude * sin(now * speed);
    leftArmServo.write(90 + angle);
    rightArmServo.write(90 - angle);
  } else {
    leftArmServo.write(90);
    rightArmServo.write(90);
  }
}

// ===== Game Mode Movement Functions =====
void goForwardGame() { 
  currentRobotState = FORWARD; 
  digitalWrite(RMF, HIGH); digitalWrite(RMB, LOW); 
  digitalWrite(LMF, HIGH); digitalWrite(LMB, LOW); 
  showYellowBlueGame(); 
  manualBlinkColor = CRGB::Black;
}

void goBackwardGame() { 
  currentRobotState = BACKWARD; 
  digitalWrite(RMF, LOW); digitalWrite(RMB, HIGH); 
  digitalWrite(LMF, LOW); digitalWrite(LMB, HIGH); 
  showYellowBlueGame(); 
  delay(150); 
  clearLEDs(); 
  delay(150); 
  manualBlinkColor = CRGB::Black;
}

void turnLeftGame() { 
  currentRobotState = LEFT; 
  digitalWrite(RMF, HIGH); digitalWrite(RMB, LOW); 
  digitalWrite(LMF, LOW); digitalWrite(LMB, HIGH); 
  if (gameSubMode == MANUAL) manualBlinkColor = CRGB::Yellow;
  else { showYellowBlueGame(); manualBlinkColor = CRGB::Black; }
}

void turnRightGame() { 
  currentRobotState = RIGHT; 
  digitalWrite(RMF, LOW); digitalWrite(RMB, HIGH); 
  digitalWrite(LMF, HIGH); digitalWrite(LMB, LOW); 
  if (gameSubMode == MANUAL) manualBlinkColor = CRGB::Red;
  else { showYellowBlueGame(); manualBlinkColor = CRGB::Black; }
}

