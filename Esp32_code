// Common get distance
float getDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return -1;
  return duration * 0.034 / 2;
}

// Digit Detection: Detect object with stable readings
bool detectObject() {
  int stableCount = 0;
  float lastDistance = 0;

  for (int i = 0; i < STABLE_READINGS; i++) {
    float distance = getDistance();
    if (distance > 0 && distance <= DETECTION_DISTANCE) {
      if (abs(distance - lastDistance) < 1.0) { // Within 1cm tolerance
        stableCount++;
      } else {
        stableCount = 1; // Reset count if reading is not stable
      }
      lastDistance = distance;
    } else {
      return false; // Object not in range
    }
    delay(READING_DELAY);
  }
  return (stableCount >= STABLE_READINGS);
}

// Digit Detection: Capture and process digit from ESP32-CAM
String captureAndProcessDigit() {
  HTTPClient http;
  String url = "http://" + String(esp32cam_ip) + "/capture_and_ocr";
  Serial.println("🔄 Requesting FRESH digit capture from ESP32-CAM...");
  Serial.println("⏱ ESP32-CAM will clear buffer before capture to prevent old images");
  http.begin(url);
  http.setTimeout(35000); // Increased timeout for buffer clearing
  int httpResponseCode = http.GET();
  String response = "";
  if (httpResponseCode == 200) {
    response = http.getString();
    Serial.println("ESP32-CAM Response: " + response);
    JsonDocument doc;
    deserializeJson(doc, response);
    if (doc["success"]) {
      String digit = doc["digit"];
      Serial.println("Digit successfully captured: " + digit);
      http.end();
      return digit;
    } else {
      Serial.println("ESP32-CAM failed to capture digit: " + String((const char*)doc["error"]));
    }
  } else {
    Serial.println("HTTP request failed: " + String(httpResponseCode));
    if (httpResponseCode > 0) {
      response = http.getString();
      Serial.println("Error response: " + response);
    }
  }
  http.end();
  return "";
}

// Digit Detection: Compare digits
void compareDigits() {
  comparisonResult = (firstDigit == secondDigit);
  Serial.println("=== DIGIT COMPARISON RESULT ===");
  Serial.println("First digit:  " + firstDigit);
  Serial.println("Second digit: " + secondDigit);
  Serial.println("Match: " + String(comparisonResult ? "TRUE" : "FALSE"));
  Serial.println("===============================");
  SerialBT.println("Digit Comparison: " + firstDigit + " vs " + secondDigit + " -> " + (comparisonResult ? "Match" : "No Match"));
  if (comparisonResult) {
    for (int i = 0; i < 5; i++) {
      digitalWrite(SUCCESS_LED, HIGH);
      delay(200);
      digitalWrite(SUCCESS_LED, LOW);
      delay(200);
    }
    digitalWrite(SUCCESS_LED, HIGH);
  } else {
    for (int i = 0; i < 5; i++) {
      digitalWrite(ERROR_LED, HIGH);
      delay(300);
      digitalWrite(ERROR_LED, LOW);
      delay(300);
    }
  }
}

