// ===== Play Mode Arm Waving =====
void waveHandsPlay() {
  if (!waving) return;
  unsigned long currentTime = millis();
  if (currentTime - lastWaveTime >= 5) {
    lastWaveTime = currentTime;
    servoPos += increment;
    if (servoPos >= 120 || servoPos <= 60) {
      increment = -increment;
    }
    leftArmServo.write(servoPos);
    rightArmServo.write(servoPos);
  }
}

