void drawShape() {
  if (!shapeVisible) return;
  u8g2.setDrawColor(1);
  switch (currentShape) {
    case CIRCLE: drawCircle(shapeX, shapeY); break;
    case HEART: drawHeart(shapeX, shapeY); break;
    case TRIANGLE: drawTriangle(shapeX, shapeY); break;
  }
}

// ===== OLED Update (Mode-specific behavior) =====
void updateOLED() {
  u8g2.clearBuffer();

  if (currentMode == ENTERTAINMENT_MODE) {
    u8g2.setDrawColor(0);
    u8g2.drawBox(0, 0, screenWidth, screenHeight);
    if (startupAnimation) {
      u8g2.setFont(u8g2_font_fub20_tf);
      u8g2.setDrawColor(1);
      const char* text = "Let's Dance";
      u8g2.drawStr((int)textX, centerY + 10, text);
      textX -= textSpeed;
      if (textX < -100) {
        startupAnimation = false;
        shapeX = centerX;
        shapeY = centerY;
      }
      u8g2.sendBuffer();
      return;
    }

    if (millis() - lastShapeSwitch >= SHAPE_SWITCH_INTERVAL) {
      currentShape = (ShapeType)((currentShape + 1) % 3);
      lastShapeSwitch = millis();
    }

    float targetX = shapeX;
    float targetY = shapeY;
    bool isMoving = false;
    if (currentMove == STOPPED_E) {
      if (millis() - lastIdleMove >= 1000) {
        lastIdleMove = millis();
        idleDirection = random(4);
      }
      switch (idleDirection) {
        case 0: targetX -= 2.0; isMoving = true; break;
        case 1: targetX += 2.0; isMoving = true; break;
        case 2: targetY -= 2.0; isMoving = true; break;
        case 3: targetY += 2.0; isMoving = true; break;
      }
    } else {
      switch (currentMove) {
        case FORWARD_E: targetY -= 2.0; isMoving = true; break;
        case BACKWARD_E: targetY += 2.0; isMoving = true; break;
        case TURN_LEFT_E: targetX -= 2.0; isMoving = true; break;
        case TURN_RIGHT_E: targetX += 2.0; isMoving = true; break;
        case SPIN_E: targetX += 2.0; isMoving = true; break;
        default: break;
      }
    }

    if (abs(targetX - shapeX) > 2.0) shapeX += (targetX > shapeX) ? 2.0 : -2.0;
    else shapeX = targetX;
    if (abs(targetY - shapeY) > 2.0) shapeY += (targetY > shapeY) ? 2.0 : -2.0;
    else shapeY = targetY;

    shapeX = constrain(shapeX, 40, screenWidth - 40);
    shapeY = constrain(shapeY, 40, screenHeight - 40);

    if (isMoving) {
      lastMoveTime = millis();
      showText = false;
    } else if (millis() - lastMoveTime >= TEXT_DELAY) {
      showText = true;
    }

    if (showText) {
      u8g2.setFont(u8g2_font_fub20_tf);
      u8g2.setDrawColor(1);
      const char* text = "Let's Dance";
      int textWidth = u8g2.getStrWidth(text);
      u8g2.drawStr((screenWidth - textWidth) / 2, centerY + 10, text);
    } else {
      if (shapeVisible && millis() - lastBlink >= BLINK_ON) {
        shapeVisible = false;
        lastBlink = millis();
      } else if (!shapeVisible && millis() - lastBlink >= BLINK_OFF) {
        shapeVisible = true;
        lastBlink = millis();
      }
      drawShape();
    }
  } else {
    int targetX = centerX;
    int targetY = centerY;
    int openBlinkThreshold = (currentMode == GAME_MODE) ? 500 : 400;
    float verticalOffset = (currentMode == GAME_MODE) ? 40 : 50;

    if (currentRobotState == STOP && currentMode == PLAY_MODE) {
      unsigned long currentTime = millis();
      if (currentTime - lastIdleMove >= 1000) {
        lastIdleMove = currentTime;
        idleDirection++;
        if (idleDirection > 8) idleDirection = 0;
      }
      if (idleDirection == 1) targetX = centerX - 25;
      else if (idleDirection == 3) targetX = centerX + 25;
      else if (idleDirection == 5) targetY = centerY - verticalOffset;
      else if (idleDirection == 7) targetY = centerY + verticalOffset;
    } else {
      switch (currentRobotState) {
        case FORWARD:  targetY = centerY - verticalOffset; break;
        case BACKWARD: targetY = centerY + verticalOffset; break;
        case LEFT:     targetX = centerX - 25; break;
        case RIGHT:    targetX = centerX + 25; break;
        default: break;
      }
    }

    if (abs(targetX - currentX) > moveSpeed)
      currentX += (targetX > currentX) ? moveSpeed : -moveSpeed;
    else
      currentX = targetX;

    if (abs(targetY - currentY) > moveSpeed)
      currentY += (targetY > currentY) ? moveSpeed : -moveSpeed;
    else
      currentY = targetY;

    currentX = constrain(currentX, eyeballRadius, screenWidth - eyeballRadius);
    currentY = constrain(currentY, eyeballRadius, screenHeight - eyeballRadius);

    float eyeHeightRatio = 1.0f;
    switch (blinkState) {
      case OPEN:
        blinkTimer += frameDelay;
        if (blinkTimer > openBlinkThreshold) { blinkTimer = 0; blinkState = CLOSING; }
        break;
      case CLOSING:
        blinkTimer += frameDelay;
        eyeHeightRatio = 1.0f - (float)blinkTimer / 80.0f;
        if (eyeHeightRatio <= 0.0f) { eyeHeightRatio = 0.0f; blinkState = CLOSED; blinkTimer = 0; }
        break;
      case CLOSED:
        blinkTimer += frameDelay;
        eyeHeightRatio = 0.0f;
        if (blinkTimer > 50) { blinkState = OPENING; blinkTimer = 0; }
        break;
      case OPENING:
        blinkTimer += frameDelay;
        eyeHeightRatio = (float)blinkTimer / 80.0f;
        if (eyeHeightRatio >= 1.0f) { blinkState = OPEN; blinkTimer = 0; }
        break;
    }

    drawEye(currentMode == PLAY_MODE, currentX, currentY, eyeHeightRatio);
  }
  u8g2.sendBuffer();
}

// ===== Game Mode LED Functions =====
void showYellowBlueGame() {
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = (i % 2 == 0) ? CRGB::Yellow : CRGB::Blue;
  }
  FastLED.show();
}

void showFiveColorsGame() {
  CRGB colors[5] = {CRGB::Red, CRGB::Yellow, CRGB::Blue, CRGB::Green, CRGB::Purple};
  for (int i = 0; i < NUM_LEDS; i++) {
    leds[i] = colors[i % 5];
  }
  FastLED.show();
}

void loadingPatternGame(CRGB color, int loops = 2) {
  for (int l = 0; l < loops; l++) {
    for (int i = 0; i < NUM_LEDS; i++) {
      leds[i] = color;
      FastLED.show();
      delay(40);
      leds[i] = CRGB::Black;
    }
  }
}

void sequenceColorsLoadingGame() {
  CRGB colors[5] = {CRGB::Red, CRGB::Yellow, CRGB::Blue, CRGB::Green, CRGB::Purple};
  for (int c = 0; c < 5; c++) {
    loadingPatternGame(colors[c], 1);
  }
}

// ===== Game Mode Arm Update =====
void updateArmsGame(RobotState state) {
  switch(state) {
    case FORWARD:
      leftArmServo.write(135);
      rightArmServo.write(45);
      break;
    case BACKWARD:
      leftArmServo.write(45);
      rightArmServo.write(135);
      break;
    case LEFT:
      leftArmServo.write(90);
      rightArmServo.write(45);
      break;
    case RIGHT:
      leftArmServo.write(135);
      rightArmServo.write(90);
      break;
    case STOP:
    default:
      leftArmServo.write(90);
      rightArmServo.write(90);
      break;
  }
}

