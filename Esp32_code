// ===== Game Mode Bluetooth Command Handler =====
void handleBTCommand(String cmd) {
  Serial.println("BT Command: " + cmd);

  if (cmd.length() != 1) {
    Serial.println("Unknown command");
    SerialBT.println("Unknown command");
    return;
  }

  char command = cmd[0];
  switch (command) {
    case 'F':
      moveForwardGame();
      inManualMode = true;
      manualStartTime = millis();
      SerialBT.println("Moving Forward");
      break;

    case 'B':
      moveBackwardGame();
      inManualMode = true;
      manualStartTime = millis();
      SerialBT.println("Moving Backward");
      break;

    case 'L':
      turnLeftGame();
      delay(1000);       // Turn for 1 second
      stopNowGame();      // Then stop
      inManualMode = false; // Immediately go back to line following
      SerialBT.println("Turning Left");
      return; // Skip normal manual timer

    case 'R':
      turnRightGame();
      delay(1000);       // Turn for 1 second
      stopNowGame();      // Then stop
      inManualMode = false; // Immediately go back to line following
      SerialBT.println("Turning Right");
      return; // Skip normal manual timer

    case 'S':
      stopNowGame();
      inManualMode = true;
      manualStartTime = millis();
      SerialBT.println("Stopped");
      break;

    default:
      Serial.println("Unknown command");
      SerialBT.println("Unknown command");
      break;
  }
}

// ===== Game Mode Get Digit from ESP32-CAM =====
String getDigitFromCam() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(espCamUrl);
    int httpCode = http.GET();
    if (httpCode == 200) {
      String payload = http.getString();
      StaticJsonDocument<200> doc;
      DeserializationError error = deserializeJson(doc, payload);
      if (!error && doc["success"]) {
        return doc["digit"].as<String>();
      } else {
        Serial.println("Failed to parse JSON or no success");
      }
    } else {
      Serial.printf("HTTP GET failed, code: %d\n", httpCode);
    }
    http.end();
  } else {
    Serial.println("WiFi not connected");
  }
  return "";
}

