// Entertainment Mode LED Animation
void updateLEDPattern() {
  if (millis() - lastLEDUpdate < 100) return; // 100ms update
  lastLEDUpdate = millis();

  static int offset = 0;
  offset++;

  switch (currentMove) {
    case FORWARD_E:
    case BACKWARD_E:
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[(i + offset) % NUM_LEDS] = (i % 2 == 0) ? minionYellow : minionBlue;
      }
      break;

    case TURN_LEFT_E:
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[(i + offset) % NUM_LEDS] = (i % 2 == 0) ? minionBlue : minionYellow;
      }
      break;

    case TURN_RIGHT_E:
    case SPIN_E:
      for (int i = 0; i < NUM_LEDS; i++) {
        leds[(i - offset + NUM_LEDS) % NUM_LEDS] = (i % 2 == 0) ? minionYellow : minionBlue;
      }
      break;

    default:
      break;
  }

  FastLED.show();
}

// Entertainment Mode Servo Motion when Motors Run
void updateServoMotion() {
  if (millis() - lastServoUpdate < 100) return; // 100ms per update
  lastServoUpdate = millis();

  // Move in opposite directions
  if (servoDirection) {
    leftAngle += 5;
    rightAngle -= 5;
  } else {
    leftAngle -= 5;
    rightAngle += 5;
  }

  if (leftAngle >= 135 || leftAngle <= 45) {
    servoDirection = !servoDirection; // reverse direction
  }

  leftArmServo.write(leftAngle);
  rightArmServo.write(rightAngle);
}

// Entertainment Mode Dance Routines
void danceRoutine1() {
  static unsigned long lastStepTime = 0;
  static int step = 0;
  unsigned long interval = 1500;

  if (millis() - lastStepTime >= interval) {
    lastStepTime = millis();
    step++;
    if (step > 8) step = 1;

    switch (step) {
      case 1: moveForwardEntertain(); break;
      case 2: moveBackwardEntertain(); break;
      case 3: turnLeftEntertain(); break;
      case 4: turnRightEntertain(); break;
      case 5: stopMotorsEntertain(); waveHandsUpDown(); break;
      case 6: moveForwardEntertain(); break;
      case 7: moveBackwardEntertain(); break;
      case 8: stopMotorsEntertain(); waveHandsAlt(); break;
    }
  }
}

void danceRoutine2() {
  static unsigned long lastStepTime = 0;
  static int step = 0;
  unsigned long interval = 1200;

  if (millis() - lastStepTime >= interval) {
    lastStepTime = millis();
    step++;
    if (step > 8) step = 1;

    switch (step) {
      case 1: moveForwardEntertain(); break;
      case 2: moveBackwardEntertain(); break;
      case 3: turnRightEntertain(); break;
      case 4: turnLeftEntertain(); break;
      case 5: spinAroundEntertain(); break;
      case 6: stopMotorsEntertain(); waveHandsAlt(); break;
      case 7: moveForwardEntertain(); break;
      case 8: stopMotorsEntertain(); waveHandsTogether(); break;
    }
  }
}

// ===== Execute Game Mode (Updated with provided code) =====
void executeGameMode() {
  if (hasResult) {
    stopNowGame();
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_ncenB24_tr);
    const char* text = match ? "Win!" : "Fail";
    int16_t textWidth = u8g2.getStrWidth(text);
    u8g2.drawStr((128 - textWidth) / 2, 64, text);
    u8g2.sendBuffer();
    fill_solid(leds, NUM_LEDS, match ? CRGB::Green : CRGB::Red);
    FastLED.show();
    delay(100);
  } else {
    u8g2.clearBuffer();

    // Check for Bluetooth SPP command
    if (pendingCmd != "") {
      handleBTCommand(pendingCmd);
      pendingCmd = "";
    }

    // If in manual mode, check if 0.75s passed
    if (inManualMode) {
      if (millis() - manualStartTime >= manualDuration) {
        inManualMode = false; // back to line following
        stopNowGame();         // stop before resuming line following
      }
    }

    updateOLED();

    // If not in manual → line following
    if (!inManualMode) {
      // Ultrasonic check
      long distance = getDistance();
      if ((obstacleToggle && distance > 0 && distance <= 10) || (!obstacleToggle && distance > 0 && distance <= 5)) {
        handleObstacle();
      } else {
        lineFollowing();
      }
    }

    // Update LED animations
    EVERY_N_MILLISECONDS(20) {
      gHue++; // Slowly cycle the "base color"
    }
    FastLED.show();
    delay(100);
  }
}

