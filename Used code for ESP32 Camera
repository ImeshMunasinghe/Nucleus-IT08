 bool initCamera() {
  // Power cycle camera first for stability
  pinMode(PWDN_GPIO_NUM, OUTPUT);
  digitalWrite(PWDN_GPIO_NUM, HIGH);
  delay(100);
  digitalWrite(PWDN_GPIO_NUM, LOW);
  delay(100);

  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sscb_sda = SIOD_GPIO_NUM;
  config.pin_sscb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  
  // Try multiple times with different settings for reliability
  for (int attempt = 0; attempt < 3; attempt++) {
    Serial.printf("Camera init attempt %d...\n", attempt + 1);
    
    // Adjust settings per attempt
    switch(attempt) {
      case 0:
        config.frame_size = FRAMESIZE_SVGA; // 800x600 - best for OCR
        config.jpeg_quality = 10; // High quality
        config.fb_count = 2;
        config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
        break;
      case 1:
        config.frame_size = FRAMESIZE_VGA; // 640x480
        config.jpeg_quality = 12;
        config.fb_count = 1;
        break;
      case 2:
        config.frame_size = FRAMESIZE_CIF; // 352x288
        config.jpeg_quality = 15;
        config.fb_count = 1;
        break;
    }

    esp_err_t err = esp_camera_init(&config);
    if (err == ESP_OK) {
      Serial.printf("✅ Camera initialized successfully on attempt %d\n", attempt + 1);
      
      // Test capture immediately
      camera_fb_t* test_fb = esp_camera_fb_get();
      if (test_fb && test_fb->len > 5000) {
        Serial.printf("✅ Test capture successful: %d bytes\n", test_fb->len);
        esp_camera_fb_return(test_fb);
        return true;
      } else {
        Serial.println("❌ Test capture failed, retrying...");
        if (test_fb) esp_camera_fb_return(test_fb);
        esp_camera_deinit();
        delay(1000);
      }
    } else {
      Serial.printf("❌ Camera init failed with error 0x%x\n", err);
      delay(1000);
    }
  }
  
    return false;
}

void configureCameraSensor() {
  sensor_t* s = esp_camera_sensor_get();
  if (s == NULL) {
    Serial.println("❌ Failed to get camera sensor");
    return;
  }

  // Optimized settings for digit recognition (no flash)
  s->set_brightness(s, 0);       // -2 to 2
  s->set_contrast(s, 1);         // Increased for better digit edges
  s->set_saturation(s, -1);      // Slightly desaturated
  s->set_special_effect(s, 0);   // No effects
  s->set_whitebal(s, 1);         // Enable white balance
  s->set_awb_gain(s, 1);         // Enable AWB gain
  s->set_wb_mode(s, 0);          // Auto white balance
  s->set_exposure_ctrl(s, 1);    // Enable exposure control
  s->set_aec2(s, 0);             // Disable AEC2
  s->set_ae_level(s, 0);         // Auto exposure level
  s->set_aec_value(s, 400);      // Slightly higher exposure for no flash
  s->set_gain_ctrl(s, 1);        // Enable gain control
  s->set_agc_gain(s, 2);         // Moderate gain for low light
  s->set_gainceiling(s, (gainceiling_t)2);
  s->set_bpc(s, 1);              // Enable BPC
  s->set_wpc(s, 1);              // Enable WPC
  s->set_raw_gma(s, 1);          // Enable raw GMA
  s->set_lenc(s, 1);             // Enable lens correction
  s->set_hmirror(s, 0);          // No horizontal mirror
  s->set_vflip(s, 0);            // No vertical flip
  s->set_dcw(s, 1);              // Enable DCW
  s->set_colorbar(s, 0);         // Disable color bar
  
  Serial.println("✅ Camera sensor configured for natural light OCR");
}

// Function to force clear camera buffer completely
void forceClearCameraBuffer() {
  Serial.println("🧹 FORCE CLEARING CAMERA BUFFER...");
  
  // Method 1: Multiple rapid captures and discards
  for (int i = 0; i < 10; i++) {
    camera_fb_t* discard_fb = esp_camera_fb_get();
    if (discard_fb) {
      Serial.printf("🗑️ Discarded buffer frame %d: %d bytes\n", i + 1, discard_fb->len);
      esp_camera_fb_return(discard_fb);
      delay(25); // Short delay between discards
    } else {
      break;
    }
  }
  
  // Method 2: Give camera time to capture fresh frame
  Serial.println("⏱️ Camera stabilization delay...");
  delay(300);
  
  // Method 3: One more flush cycle
  camera_fb_t* final_flush = esp_camera_fb_get();
  if (final_flush) {
    Serial.printf("🗑️ Final flush: %d bytes\n", final_flush->len);
    esp_camera_fb_return(final_flush);
  }
  
  delay(100);
  Serial.println("✅ Buffer clearing complete - ready for fresh capture");
}
 
