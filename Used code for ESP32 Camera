 // Enhanced camera capture with aggressive buffer flushing (no flash)
camera_fb_t* robustCameraCapture(int max_retries = 5) {
  camera_fb_t* fb = NULL;
  
  Serial.println("🔄 AGGRESSIVE BUFFER FLUSH - Clearing old cached frames...");
  
  // AGGRESSIVE BUFFER FLUSHING - Clear ALL old cached frames
  for (int flush_count = 0; flush_count < 5; flush_count++) {
    camera_fb_t* flush_fb = esp_camera_fb_get();
    if (flush_fb) {
      Serial.printf("🗑️ Flushed cached frame %d: %d bytes\n", flush_count + 1, flush_fb->len);
      esp_camera_fb_return(flush_fb);
      delay(50); // Small delay between flushes
    } else {
      break; // No more cached frames
    }
  }
  
  Serial.println("⏱️ Waiting for camera to stabilize...");
  delay(200); // Give camera time to stabilize after flush
  
  for (int attempt = 0; attempt < max_retries; attempt++) {
    Serial.printf("📸 Fresh capture attempt %d/%d (post-flush)\n", attempt + 1, max_retries);
    
    // Additional flush between attempts if needed
    if (attempt > 0) {
      camera_fb_t* flush_fb = esp_camera_fb_get();
      if (flush_fb) {
        Serial.printf("🗑️ Mid-attempt flush: %d bytes\n", flush_fb->len);
        esp_camera_fb_return(flush_fb);
      }
      delay(150); // Longer delay between attempts
    }
    
    fb = esp_camera_fb_get();
    
    if (fb != NULL && fb->len > 5000 && fb->buf != NULL) {
      Serial.printf("✅ Fresh capture successful: %d bytes\n", fb->len);
      return fb;
    } else {
      if (fb) {
        Serial.printf("❌ Invalid fresh frame: size=%d, buf=%p\n", fb->len, fb->buf);
        esp_camera_fb_return(fb);
        fb = NULL;
      } else {
        Serial.println("❌ Fresh capture returned NULL");
      }
    }
    
    delay(200 * (attempt + 1)); // Progressive delays
  }
  
  Serial.println("❌ All fresh capture attempts failed");
  return NULL;
}

void handleCapture() {
  Serial.println("\n📸 === CAPTURE REQUEST (NO FLASH) ===");
  
  // Clear buffer for fresh capture
  forceClearCameraBuffer();
  
  // NO FLASH - Using natural light only
  Serial.println("📷 Capturing FRESH image with natural light...");
  
  camera_fb_t * fb = robustCameraCapture(5);
  
  if (!fb) {
    Serial.println("❌ Camera capture failed after multiple attempts");
    server.send(500, "text/plain", "Camera capture failed - check lighting and camera");
    return;
  }
  
  Serial.printf("✅ Camera capture successful: %d bytes\n", fb->len);
  
  server.sendHeader("Content-Disposition", "attachment; filename=capture.jpg");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send_P(200, "image/jpeg", (const char *)fb->buf, fb->len);
  
  esp_camera_fb_return(fb);
  Serial.println("📸 === CAPTURE COMPLETE ===\n");
}
 
 void handleCaptureAndOCR() {
 Serial.println("\n🤖 === CAPTURE AND OCR REQUEST (NO FLASH) ===");
 
 // CRITICAL: Force clear buffer before OCR capture to prevent old images
 forceClearCameraBuffer();
 
 // NO FLASH - Using natural light for OCR
 Serial.println("📷 Capturing FRESH image for OCR with natural light...");
 
 camera_fb_t * fb = robustCameraCapture(5);
 
 if (!fb) {
   Serial.println("❌ Camera capture failed for OCR after multiple attempts");
   String errorResponse = "{\"success\":false,\"error\":\"Camera capture failed - check lighting\"}";
   server.send(500, "application/json", errorResponse);
   return;
 }
 
    Serial.printf("✅ Camera capture for OCR successful: %d bytes\n", fb->len);
   
   // Send image to Python OCR server
   String digit = processImageWithOCR(fb->buf, fb->len);
   
   esp_camera_fb_return(fb);
   
   // Prepare JSON response
   JsonDocument doc;
   
   if (digit != "") {
     doc["success"] = true;
     doc["digit"] = digit;
     doc["timestamp"] = millis();
     Serial.println("🎯 OCR Success - Digit: " + digit);
   } else {
     doc["success"] = false;
     doc["error"] = "OCR processing failed - no digit detected (check lighting)";
     Serial.println("❌ OCR Failed - No digit detected");
   }
   
   String response;
   serializeJson(doc, response);
   
   server.send(doc["success"] ? 200 : 500, "application/json", response);
   Serial.println("🤖 === OCR REQUEST COMPLETE ===\n");
 }
 
 String processImageWithOCR(const uint8_t* imageData, size_t imageSize) {
  HTTPClient http;
  
  String url = "http://" + String(ocr_server_ip) + ":" + String(ocr_server_port) + "/process_image";
  
  Serial.println("Sending image to OCR server: " + url);
  
  http.begin(url);
  http.setTimeout(30000); // 30 second timeout
  http.addHeader("Content-Type", "image/jpeg");
  
  // Send POST request with image data (cast to non-const)
  int httpResponseCode = http.POST((uint8_t*)imageData, imageSize);
   
   String digit = "";
   
   if (httpResponseCode == 200) {
     String response = http.getString();
     Serial.println("OCR Server Response: " + response);
     
         // Parse JSON response
    JsonDocument doc;
    DeserializationError error = deserializeJson(doc, response);
     
     if (!error && doc["success"]) {
       digit = doc["digit"].as<String>();
       Serial.println("Digit extracted: " + digit);
     } else {
       Serial.println("OCR parsing failed or no digit found");
       if (!error) {
         Serial.println("Error from OCR: " + String((const char*)doc["error"]));
       }
     }
   } else {
     Serial.println("HTTP request to OCR server failed: " + String(httpResponseCode));
     if (httpResponseCode > 0) {
       String errorResponse = http.getString();
       Serial.println("Error response: " + errorResponse);
     }
   }
   
   http.end();
   return digit;
 }
 
 void handleStream() {
   // Simple MJPEG stream
   WiFiClient client = server.client();
   
   String response = "HTTP/1.1 200 OK\r\n";
   response += "Content-Type: multipart/x-mixed-replace; boundary=frame\r\n\r\n";
   server.sendContent(response);
   
   while (client.connected()) {
     camera_fb_t * fb = esp_camera_fb_get();
     if (!fb) {
       Serial.println("Camera capture failed");
       break;
     }
     
     String frame = "--frame\r\n";
     frame += "Content-Type: image/jpeg\r\n\r\n";
     server.sendContent(frame);
     
     client.write(fb->buf, fb->len);
     server.sendContent("\r\n");
     
     esp_camera_fb_return(fb);
     
     if (!client.connected()) {
       break;
     }
     
     delay(100);
   }
 }
